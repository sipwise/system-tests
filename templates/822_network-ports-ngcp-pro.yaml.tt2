[%
  hostname = ngcp.get_hostname();
  peername = ngcp.get_peername(hostname);

  is_mgmt = ngcp.has_role(hostname, 'mgmt');

  argv.host = hostname;
  argv.type = 'mon_ext';
  PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_shared_ips_for_host';
  mon_ips_shared_ext = out;

  argv.role = hostname;
  argv.type = 'mon_ext';
  PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_ips_for_host';
  mon_ips_ext = out;

  mon_ips = [ hosts.$hostname.lo.ip ];
  mon_ips = mon_ips.import(mon_ips_ext);
  mon_ips = mon_ips.import(mon_ips_shared_ext);

  mon_v6ips = [];
  IF hosts.$hostname.lo.v6ip;
    mon_v6ips.push(hosts.$hostname.lo.v6ip);
  END;

  argv.type = 'ha_int';
  argv.host = hostname;
  PROCESS '/usr/lib/ngcp-ngcpcfg/get_iface';
  host_ha_iface = out;
-%]
port:
  # dnsmasq (DNS)
  tcp:53:
    listening: {{if and [% is_mgmt ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["0.0.0.0"]
  tcp6:53:
    listening: {{if and [% is_mgmt ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["::"]
  udp:53:
    listening: {{if and [% is_mgmt ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["0.0.0.0"]
  udp6:53:
    listening: {{if and [% is_mgmt ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["::"]
  # dnsmasq (DHCPv4)
  udp:67:
    listening: {{if and [% is_mgmt ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["0.0.0.0"]
  # dnsmasq (TFTP)
  udp:69:
    listening: {{if and [% is_mgmt ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["0.0.0.0"]
  udp6:69:
    listening: {{if and [% is_mgmt ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["::"]

  # snmpd
  udp:161:
    listening: true
    ip:
[% FOREACH ip IN mon_ips.unique.sort -%]
      - "[% ip %]"
[% END -%]

  udp6:161:
    listening: [% mon_v6ips.size ? 'true' : 'false' %]
    ip:
[% FOREACH ip IN mon_v6ips -%]
      - "[% ip %]"
[% END -%]

  # Corosync
  udp:5405:
    listening: [% ha.gcs == 'corosync' ? 'true' : 'false' %]
    ip: ["[% hosts.$hostname.$host_ha_iface.ip %]"]
