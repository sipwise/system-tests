file:

  /etc/apt/sources.list.d/sipwise.list:
    exists: true
    mode: [% general.ngcp_type == 'spce' ? '"0644"' : '"0444"' %]
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/ngcp-config/config.yml:
    exists: true
[% IF sites_enable == 'yes' -%]
    mode: "0777"
    owner: root
    group: root
    filetype: symlink
    linked-to: sites/current/config.yml
[% ELSE -%]
    mode: "0660"
    owner: root
    group: _ngcp-admin
    filetype: file
    contents: []
[% END -%]

  /etc/ngcp-config/constants.yml:
    exists: true
[% IF sites_enable == 'yes' -%]
    mode: "0777"
    owner: root
    group: root
    filetype: symlink
    linked-to: sites/current/constants.yml
[% ELSE -%]
    mode: "0600"
    owner: root
    group: root
    filetype: file
    contents: []
[% END -%]

  /etc/ngcp-config/maintenance.yml:
    exists: true
[% IF sites_enable == 'yes' -%]
    mode: "0777"
    owner: root
    group: root
    filetype: symlink
    linked-to: sites/current/maintenance.yml
[% ELSE -%]
    mode: "0660"
    owner: root
    group: _ngcp-admin
    filetype: file
    contents: []
[% END -%]

  /etc/ngcp-config/network.yml:
    exists: true
[% IF sites_enable == 'yes' -%]
    mode: "0777"
    owner: root
    group: root
    filetype: symlink
    linked-to: sites/current/network.yml
[% ELSE -%]
    mode: "0660"
    owner: root
    group: _ngcp-admin
    filetype: file
    contents: []
[% END -%]

  /etc/ngcp-config/.git:
    exists: true
    mode: "0700"
    owner: root
    group: root
    filetype: directory
    contents: []

  /etc/ngcp-config/cfg_schema.db:
    exists: true
[% IF sites_enable == 'yes' -%]
    mode: "0777"
    owner: root
    group: root
    filetype: symlink
    linked-to: sites/current/cfg_schema.db
[% ELSE -%]
    mode: "0644"
    owner: root
    group: root
    filetype: file
    contents: []
[% END -%]

  /etc/ngcp-config/.ngcpcfg_perms:
    exists: true
    mode: "0700"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/ngcp-config/ngcpcfg.cfg:
    exists: false

  /etc/ngcp-ngcpcfg/ngcpcfg.cfg:
    exists: true
    mode: "0644"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/ngcp-config/ssl:
    exists: false

  /etc/ngcp-config/shared-files/ssl:
    exists: true
    mode: "0750"
    owner: root
    group: ssl-cert
    filetype: directory
    contents: []

  /etc/ngcp_version:
    exists: true
    mode: "0644"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/sipwise_ngcp_version:
    exists: true
    mode: "0644"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory
    contents: []

  /etc/mysql/conf.d:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory
    contents: []

  /etc/mysql/debian-start:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/debian.cnf:
    exists: true
    mode: "0440"
    owner: root
    group: mysql
    filetype: file
    contents: []

  /etc/mysql/grants.yml:
    exists: true
    mode: "0400"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/inc:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory
    contents: []

  /etc/mysql/mariadb.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents:
    - '/^\[mysql\]$/'
    - '/^\[mysqld\]$/'
    - '/^\[mysqldump\]$/'

  /etc/mysql/inc/my.client.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/inc/my.myisamchk.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/inc/my.mysql.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/inc/my.safe_mysqld.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/inc/my.mysqldump.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/my.cnf:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /etc/alternatives/my.cnf
    filetype: symlink
    contents: []

  /etc/mysql/sipwise.cnf:
    exists: false
    filetype: file

  /etc/mysql/sipwise_extra.cnf:
    exists: true
    mode: "0400"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/alternatives/my.cnf:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /etc/mysql/mariadb.cnf
    filetype: symlink
    contents: []

  /ngcp-data/backup:
    exists: true
    mode: "0700"
    owner: root
    group: root
    filetype: directory

  /ngcp-data/backup/cdr:
    exists: true
    mode: "0700"
    owner: root
    group: root
    filetype: directory

  /var/backup:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /ngcp-data/backup
    filetype: symlink

  /ngcp-data/prometheus:
    exists: true
    mode: "0755"
    owner: prometheus
    group: prometheus
    filetype: directory

  /var/lib/prometheus:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /ngcp-data/prometheus
    filetype: symlink

  /ngcp-data/victoria-metrics:
    exists: true
    mode: "0755"
    owner: _victoria-metrics
    group: _victoria-metrics
    filetype: directory

  /var/lib/victoria-metrics:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /ngcp-data/victoria-metrics
    filetype: symlink

  /ngcp-data/valkey:
    exists: true
    mode: "0750"
    owner: valkey
    group: valkey
    filetype: directory

  /var/lib/valkey:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /ngcp-data/valkey
    filetype: symlink

  /ngcp-data/logs:
    exists: true
    mode: "0755"
    owner: root
    group: adm
    filetype: directory

  /var/log/ngcp:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /ngcp-data/logs
    filetype: symlink

  /ngcp-data/tmp:
    exists: true
    mode: "1777"
    owner: root
    group: root
    filetype: directory

  /ngcp-data/tmp/mysql:
    exists: true
    mode: "0750"
    owner: mysql
    group: mysql
    filetype: directory

  /ngcp-data/tmp/www-data:
    exists: true
    mode: "0770"
    owner: root
    group: www-data
    filetype: directory

  /ngcp-data/cache/ngcp-sems:
    exists: true
    mode: "0755"
    owner: sems
    group: sems
    filetype: directory

  /var/cache/ngcp-sems:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /ngcp-data/cache/ngcp-sems
    filetype: symlink
