[%
  hostname = ngcp.get_hostname();

  is_proxy = ngcp.has_role(hostname, 'proxy');
  is_lb = ngcp.has_role(hostname, 'lb');
  is_mgmt = ngcp.has_role(hostname, 'mgmt');
  is_db = ngcp.has_role(hostname, 'db');
  is_rtp = ngcp.has_role(hostname, 'rtp');

  argv.host = hostname;
  argv.type = 'sip_ext';
  PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_shared_ips_for_host';
  sip_ext_ips = out;

  IF !sip_ext_ips.size;
    argv.host = hostname;
    argv.type = 'sip_ext';
    PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_ips_for_host';
    sip_ext_ips = out;
  END;

  argv.host = hostname;
  argv.type = 'sip_int';
  PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_shared_ips_for_host';
  sip_int_ips = out;

  IF !sip_int_ips.size;
    argv.host = hostname;
    argv.type = 'sip_int';
    PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_ips_for_host';
    sip_int_ips = out;
  END;

  IF haproxy.enable == 'yes';
    sip_proxy_ip = sip_int_ips.0;
  ELSE;
    sip_proxy_ip = sip_ext_ips.0;
  END;

  argv.host = hostname;
  argv.type = 'web_ext';
  PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_shared_ips_for_host';
  web_ext_ips = out;

  IF !web_ext_ips.size;
    argv.host = hostname;
    argv.type = 'web_ext';
    PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_ips_for_host';
    web_ext_ips = out;
  END;

  argv.host = hostname;
  argv.type = 'web_int';
  PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_shared_ips_for_host';
  web_int_ips = out;

  IF !web_int_ips.size;
    argv.host = hostname;
    argv.type = 'web_int';
    PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_ips_for_host';
    web_int_ips = out;
  END;

  argv.host = hostname;
  argv.type = 'ha_int';
  PROCESS '/usr/lib/ngcp-ngcpcfg/get_all_ips_for_host';
  ha_int_ips = out;

  int_ips = ['127.0.0.1', ha_int_ips.0];
  int_ips = int_ips.sort.unique;
-%]

port:

  # Nginx (IPv6 due to listening on all address families)
  tcp6:80:
    listening: [% is_mgmt ? 'true' : 'false' %]

  # Nginx HTTPS (NGCP Panel)
  tcp:443:
    listening: [% is_mgmt ? 'true' : 'false' %]
    ip: ["[% web_ext_ips.0 %]"]

  # Nginx HTTPS (NGCP Panel API)
  tcp:1442:
    listening: [% is_mgmt ? 'true' : 'false' %]
    ip: ["127.0.0.1"]
  tcp6:1442:
    listening: [% is_mgmt ? 'true' : 'false' %]
    ip: ["::1"]

  # Nginx HTTPS (NGCP Panel Admin)
  tcp:1443:
    listening: [% is_mgmt ? 'true' : 'false' %]
    ip: ["[% web_int_ips.0 %]"]

  # Nginx status port
  tcp:[% nginx.status_port %]:
    listening: [% is_mgmt ? 'true' : 'false' %]
    ip: ["127.0.0.1"]
  tcp6:[% nginx.status_port %]:
    listening: [% is_mgmt ? 'true' : 'false' %]
    ip: ["::1"]

  # HTTPS PBX autoprovisioning
  tcp:1444:
    listening: [% is_mgmt && pbx.enable == 'yes' ? 'true' : 'false' %]
    ip: ["[% web_ext_ips.0 %]"]

  # HTTP PBX autoprovisioning
  tcp:1445:
    listening: [% is_mgmt && pbx.enable == 'yes' ? 'true' : 'false' %]
    ip: ["[% web_ext_ips.0 %]"]

  # MySQL
[%
  IF general.ngcp_type == 'spce';
    ip_list = ['127.0.0.1'];
  ELSE;
    IF mariadb.bind_all_interfaces == 'no';
      ip_list = int_ips;
    ELSE;
      ip_list = ['0.0.0.0'];
    END;
  END;
-%]
  tcp:3306:
    listening: true
    ip:
[% FOREACH ip IN ip_list -%]
    - "[% ip %]"
[% END -%]

  # Kamailio load-balancer
  tcp:5060:
    listening: {{if and [% is_lb ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["[% sip_ext_ips.0 %]"]

  # Kamailio proxy
  tcp:5062:
    listening: {{if and [% is_proxy ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["[% sip_int_ips.0 %]"]

[% IF is_proxy -%]
  # Prosody (xmpp-client)
  tcp:5222:
    listening: false
    ip: ["[% sip_proxy_ip %]"]

[% ELSIF is_lb -%]
  # HAProxy: Prosody (xmpp-client)
  tcp:5222:
    listening: false
    ip: ["[% sip_ext_ips.0 %]"]

[% END -%]
[% IF is_proxy -%]
  # Prosody (xmpp-server)
  tcp:5269:
    listening: false
    ip: ["[% sip_proxy_ip %]"]

[% ELSIF is_lb -%]
  # HAProxy: Prosody (xmpp-server)
  tcp:5269:
    listening: false
    ip: ["[% sip_ext_ips.0 %]"]

[% END -%]
[% IF is_proxy -%]
  # Prosody (http)
  tcp:5280:
    listening: false
    ip: ["[% sip_int_ips.0 %]"]

[% END -%]
[% IF is_proxy -%]
  # Prosody (https)
  tcp:5281:
    listening: false
    ip: ["[% sip_int_ips.0 %]"]

[% ELSIF is_lb -%]
  # HAProxy: Prosody (http)
  tcp:5281:
    listening: false
    ip: ["[% sip_ext_ips.0 %]"]

[% END -%]
[% IF is_proxy -%]
  # Prosody (ctrl)
  tcp:5582:
    listening: false
    ip: ["[% sip_int_ips.0 %]"]

[% END -%]
  # HAProxy admin
  tcp:8080:
    listening: [% is_lb && haproxy.enable == 'yes' && haproxy.admin == 'yes' ? 'true' : 'false' %]
    ip: ["[% sip_ext_ips.0 %]"]

  # SEMS: XMLRPC server of B2B
  tcp:[% b2b.xmlrpcport %]:
    listening: {{if and [% is_proxy && b2b.enable == 'yes' ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["[% sip_int_ips.0 %]"]

  # SEMS: B2B server UDP listener
  udp:[% b2b.bindport %]:
    listening: {{if and [% is_proxy && b2b.enable == 'yes' ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["[% sip_int_ips.0 %]"]

  # SEMS: B2B server TCP listener
  tcp:[% b2b.bindport %]:
    listening: {{if and [% is_proxy && b2b.enable == 'yes' ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["[% sip_int_ips.0 %]"]

  # SEMS: Monit UDP port
  udp:[% general.ngcp_type == 'spce' ? '5040' : '5048' %]:
    listening: {{if and [% is_proxy && b2b.enable == 'yes' ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["[% sip_int_ips.0 %]"]

  # Asterisk
  tcp:5038:
    listening: {{if and [% is_proxy ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["127.0.0.1"]

  # Asterisk
  udp:5070:
    listening: {{if and [% is_proxy ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["[% sip_int_ips.0 %]"]

  # Redis
  tcp:6379:
    listening: [% is_rtp || is_proxy || is_db ? 'true' : 'false' %]
    ip:
[% FOREACH ip IN int_ips -%]
    - "[% ip %]"
[% END -%]
  tcp6:6379:
    listening: [% is_rtp || is_proxy || is_db ? 'true' : 'false' %]
    ip: ["::1"]

  # rtpengine
  udp:2223:
    listening: {{if and [% is_rtp ? 1 : 0 %] .Vars.NODE_ACTIVE}} true {{else}} false {{end}}
    ip: ["[% sip_int_ips.0 %]"]
