[%
  hostname = ngcp.get_hostname();

  is_mgmt = ngcp.has_role(hostname, 'mgmt');
-%]
file:

  /etc/ngcp-config/sites.yml:
[% IF sites_enable == 'yes' -%]
    exists: true
    mode: "0644"
    owner: root
    group: root
    filetype: file
    contents: []
[% ELSE -%]
    exists: false
[% END -%]

  /etc/ngcp-config/sites:
[% IF sites_enable == 'yes' -%]
    exists: true
    filetype: directory
    mode: "0755"
    owner: root
    group: root
    contents: []
[% ELSE -%]
    exists: false
[% END -%]

[% IF sites_enable == 'yes' -%]
[%   FOREACH site IN sites.keys -%]
  /etc/ngcp-config/sites/[% site %]:
    exists: true
[%     IF site == 'current' -%]
    filetype: symlink
    mode: "0777"
[%     ELSE -%]
    filetype: directory
    mode: "0755"
[%     END -%]
    owner: root
    group: root
    contents: []
[%   END -%]
[% ELSE -%]
  /etc/ngcp-config/sites/current:
    exists: false
[% END -%]

  /etc/ngcp-config/shared-files:
    exists: true
[% IF sites_enable == 'yes' -%]
    filetype: symlink
    linked-to: sites/current/shared-files
    mode: "0777"
[% ELSE -%]
    filetype: directory
    mode: "0755"
    contents: []
[% END -%]
    owner: root
    group: root

  /etc/ngcp-config/shared-files/ssh:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory
    contents: []

  /etc/ngcp-config/shared-files/sshd:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory
    contents: []

  /etc/ngcp-config/systems.cfg:
    exists: false

  /mnt/glusterfs:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory

  /mnt/glusterfs/home:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory

  /mnt/glusterfs/home/jail:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory

  /mnt/glusterfs/mgmt-share:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory

  /mnt/glusterfs/mgmt-share/approx:
    exists: true
    mode: "0755"
    owner: approx
    group: approx
    filetype: directory

  /mnt/glusterfs/mgmt-share/ipxe.cfg:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory

  /mnt/glusterfs/mgmt-share/tftp:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory

  /mnt/glusterfs/mgmt-share/tftp/undionly.kpxe:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /usr/share/ngcp-pxe-boot-images/images/undionly.kpxe
    filetype: symlink

  /mnt/glusterfs/ngcpcfg-share:
    exists: [% is_mgmt ? 'true' : 'false' %]
    mode: "0700"
    owner: root
    group: root
    filetype: directory

  /mnt/glusterfs/shared_config:
    exists: false

  /var/cache/approx:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /mnt/glusterfs/mgmt-share/approx/
    filetype: symlink

  /etc/mysql/inc/my.mysqld1.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/inc/my.mysqld2.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []

  /etc/mysql/conf.d/my2.cnf:
    exists: true
    mode: "0440"
    owner: root
    group: mysql
    filetype: file
    contents: []
[% IF general.ngcp_type == 'sppro' -%]
    size: 0
[% END -%]

  /etc/mysql/inc/my.client2.cnf:
    exists: true
    mode: "0440"
    owner: root
    group: root
    filetype: file
    contents: []
[% IF general.ngcp_type == 'sppro' -%]
    size: 0
[% END -%]

  /etc/mysql/client.local.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []
[% IF general.ngcp_type == 'sppro' -%]
    size: 0
[% END -%]

  /etc/mysql/client.central.cnf:
    exists: true
    mode: "0444"
    owner: root
    group: root
    filetype: file
    contents: []
[% IF general.ngcp_type == 'sppro' -%]
    size: 0
[% END -%]


  /ngcp-data/logfs:
    exists: true
    mode: "0700"
    owner: root
    group: root
    filetype: directory

  /ngcp-data/spool:
    exists: true
    mode: "0755"
    owner: root
    group: root
    filetype: directory

  /ngcp-data/spool/faxserver:
    exists: true
    mode: "2770"
    owner: faxserver
    group: faxserver
    filetype: directory

  /ngcp-data/spool/websocket:
    exists: true
    mode: "2770"
    owner: websocket
    group: websocket
    filetype: directory

  /ngcp-data/cache/sems-b2b:
    exists: true
    mode: "0755"
    owner: sems-b2b
    group: sems-b2b
    filetype: directory

  /var/cache/sems-b2b:
    exists: true
    mode: "0777"
    owner: root
    group: root
    linked-to: /ngcp-data/cache/sems-b2b
    filetype: symlink
